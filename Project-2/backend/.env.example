# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_test

# JWT
JWT_SECRET=your-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Frontend
VITE_API_URL=http://localhost:3000
