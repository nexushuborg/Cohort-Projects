# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / pgAdmin 4)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace

# Test Database
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_test

# JWT Configuration
JWT_SECRET=super-secret-marketplace-jwt-key-change-in-production-12345
JWT_REFRESH_SECRET=super-secret-marketplace-jwt-refresh-key-change-in-prod-67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Frontend & CORS
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
